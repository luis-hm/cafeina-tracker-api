{
  "name": "cafeina-tracker-api",
  "version": "1.0.0",
  "description": "API didática para comparar testes automatizados com Jest e Jasmine.",
  "main": "build/src/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node build/src/index.js",
    "dev": "npm run dev:all",
    "dev:api": "tsx watch src/index.ts",
    "dev:web": "npm --prefix frontend run dev",
    "dev:all": "concurrently --kill-others-on-fail --names API,WEB --prefix-colors blue,magenta \"npm run dev:api\" \"npm run dev:web\"",
    "build:frontend": "npm --prefix frontend run build",
    "build:all": "npm run build && npm run build:frontend",
    "test": "npm run test:jest && npm run test:jasmine",
    "test:jest": "jest --config jest.config.js --runInBand",
    "test:jest:coverage": "jest --config jest.config.js --runInBand --coverage",
    "test:jest:report": "jest --config jest.config.js --runInBand --json --outputFile=.spec/verification/jest-results.json",
    "typecheck:jest": "tsc -p tests-jest/tsconfig.json --pretty false",
    "test:jasmine": "npm run build && jasmine --config=tests-jasmine/support/jasmine.json",
    "test:spec": "node -e \"require('node:fs').rmSync('.spec/verification/jest-results.json',{force:true})\" && npm run test:jasmine && npm run test:jest:report",
    "test:frontend": "npm --prefix frontend test",
    "test:all": "npm test && npm run test:frontend",
    "test:spec:all": "node scripts/run-spec-tests.mjs",
    "verify:all": "npm run build:all && npm run typecheck:jest && npm run test:all && npm --prefix frontend run lint && npm --prefix frontend run typecheck",
    "audit:all": "npm audit --audit-level=high && npm --prefix frontend audit --audit-level=high"
  },
  "keywords": [
    "typescript",
    "express",
    "jest",
    "jasmine",
    "testing"
  ],
  "license": "MIT",
  "dependencies": {
    "express": "^4.22.2"
  },
  "devDependencies": {
    "@types/express": "4.17.21",
    "@types/jasmine": "5.1.8",
    "@types/jest": "29.5.14",
    "@types/node": "22.15.3",
    "@types/supertest": "6.0.3",
    "concurrently": "^9.2.4",
    "jasmine": "5.7.1",
    "jest": "29.7.0",
    "supertest": "^7.1.3",
    "ts-jest": "29.3.2",
    "tsx": "^4.23.13",
    "typescript": "5.8.3"
  },
  "engines": {
    "node": ">=20.19"
  }
}
